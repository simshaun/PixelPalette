<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="WixToolset.Sdk/6.0.2">
  <PropertyGroup>
    <Cultures>en-us</Cultures>
    <InstallerPlatform>x86</InstallerPlatform>
    <IntermediateOutputPath>obj\$(Configuration)\</IntermediateOutputPath>
    <OutputName>PixelPalette.Installer</OutputName>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <ReleasePath>..\PixelPalette\bin\Release\win-x64\publish</ReleasePath>
    <DefineConstants>HarvestPath=$(ReleasePath)</DefineConstants>
    <SuppressIces>ICE61</SuppressIces>
    <SuppressValidation>true</SuppressValidation>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="HeatGeneratedFileList.wxs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="6.0.2" />
  </ItemGroup>
</Project>
